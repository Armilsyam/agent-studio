# AI AGENT STUDIO CONFIGURATION
# Semua API bersifat OPSIONAL! Studio dapat berjalan 100% GRATIS secara offline / client-side.

# Google Gemini API (Opsional: untuk AI generation yang lebih pintar)
GEMINI_API_KEY=

# HuggingFace API Token (Opsional: untuk Text-to-Speech & Image FX gratis)
HUGGINGFACE_API_KEY=

# Pexels API Key (Opsional: untuk pencarian stok foto/video resolusi tinggi gratis)
PEXELS_API_KEY=

# Unsplash API Key (Opsional: untuk pencarian foto resolusi tinggi gratis)
UNSPLASH_ACCESS_KEY=

# Social Media Auto-Publishing (Opsional untuk integrasi unggah otomatis)
# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Meta / Facebook Graph API (Facebook Pages & Instagram Reels)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Server Configuration
PORT=3000
NODE_ENV=development
